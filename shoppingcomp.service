[Unit]
Description=Shopping Comparison App Backend Server
Documentation=https://github.com/gauthiervq-sys/Shoppingcomp
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Shoppingcomp
ExecStart=/usr/bin/node /home/pi/Shoppingcomp/server.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
